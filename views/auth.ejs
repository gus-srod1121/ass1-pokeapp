<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- STYLES -->
        <link href="style/global.style.css" rel="stylesheet" />
        <link href="style/color.style.css" rel="stylesheet" />
        <!-- PAGE -->
        <link href="style/pages/auth.style.css" rel="stylesheet" />

        <!-- SCRIPTS -->
        <script src="src/globals.js"></script>

        <title><%= mode == "login" ? "Log In" : "Register" %></title>
    </head>
    <body>
        <%- include("components/navbar") %>

        <h1><%= mode == "login" ? "Log In" : "Register" %></h1>
        <div class="card">
            <form action="<%= mode == 'login' ? '/login' : '/register' %>" method="POST">
                <input name="username" type="text" placeholder="Username" required />
                <input name="password" type="password" placeholder="Password" required />

                <div id="remember-me-container">
                    <input id="remember-me" type="checkbox" name="remember-me" />
                    <label for="remember-me">Remember Me</label>
                </div>

                <input
                    value="<%= mode == 'login' ? 'Login' : 'Register' %>"
                    type="submit"
                    style="margin-top: 3vh"
                />
            </form>

            <p>
                <% if (mode == 'login') { %> Don't have an account?
                <a href="/register">Register</a> <% } else { %> Already have an account?
                <a href="/login">Log in</a>
                <% } %>
            </p>
        </div>
    </body>
</html>
