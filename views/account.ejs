<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- STYLES -->
        <link href="style/global.style.css" rel="stylesheet" />
        <link href="style/color.style.css" rel="stylesheet" />
        <!-- Page -->
        <link href="style/pages/account.style.css" rel="stylesheet" />

        <!-- SCRIPTS -->
        <script src="src/globals.js"></script>

        <title>Home Page</title>
    </head>
    <body class="">
        <%- include("components/navbar") %>

        <h1>Account</h1>
        <div class="flex" style="justify-content: center">
            <h3>Hello <%= username %></h3>
        </div>

        <div class="button-group">
            <% if (isAdmin) { %>
                <button onclick="window.location.href = '/admin'">Admin Dashboard</button>
            <% } %>
        </div>

        <ul>
            <form method="POST" action="/logout">
                <input value="Log Out" type="submit" />
            </form>
            <form method="POST" action="/delete-account">
                <input
                    class="<%= isAdmin ? 'button-disabled' : 'none' %>"
                    value="DELETE ACCOUNT"
                    type="submit"
                    onclick="return confirm('Are you sure? This cannot be undone');"
                    <% if (isAdmin) { %>
                        disabled
                    <% } %>
                />
            </form>
            
            <% if (isAdmin) { %>
                <p>Admins cannot delete their own account</p>
            <% } %>
        </ul>
    </body>
    <!-- Page -->
</html>
